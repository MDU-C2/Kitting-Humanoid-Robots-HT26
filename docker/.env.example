# Copy to docker/.env and adjust. Read by docker/compose.yaml.
# This repo (mounted at the same path inside the containers):
KARIS_REPO=/home/kimsv/Kitting-Humanoid-Robots-HT26
# Local data folder (local_data/ in this repo): models/, data/, videos/, bags/, meshes_isaac/;
# only on this computer (see .gitignore)
KARIS_DIR=/home/kimsv/Kitting-Humanoid-Robots-HT26/local_data
ROS_DOMAIN_ID=0
# Empty = the interface with a 192.168.123.x address
KARIS_NET_IF=
# e.g. 192.168.123.164 if multicast discovery does not work
KARIS_DDS_PEERS=
WITH_RFDETR=1
# Optional: nearer Ubuntu mirror for building the perception image (slow network)
# UBUNTU_MIRROR=http://se.archive.ubuntu.com/ubuntu
