<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_scene_updater</name>
  <version>0.1.0</version>
  <description>Puts the parts seen by the KARIS perception (/karis/markers) into MoveIt's planning scene as boxes, in the robot frame. Standard ROS 2 / MoveIt messages only; runs on the motion laptop next to move_group.</description>
  <maintainer email="kim.svedberg03@gmail.com">Kim Svedberg</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
