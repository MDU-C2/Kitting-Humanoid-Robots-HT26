+    @staticmethod
+    def _headless_slew_step(previous, target, measured, max_step, max_lead):
+        """Headless only: advance from prior COMMAND, with bounded measured lead.
+
+        Preserve synchronized joint motion through global scaling, then cap
+        absolute command/feedback separation. Never applies to Quest mode.
+        """
+        delta = target - previous
+        scale = max(1.0, float(np.max(np.abs(delta))) / max_step)
+        candidate = previous + delta / scale
+        # Clamp to measured feedback: a stalled joint cannot accumulate an
+        # arbitrarily large queued motor position command.
+        candidate = np.clip(candidate, measured - max_lead, measured + max_lead)
+        # A sudden feedback change must not cause an unbounded command jump.
+        candidate = np.clip(candidate, previous - max_step, previous + max_step)
+        return candidate
+
