<?xml version="1.0"?>
<robot name="g1_29dof_with_inspire_hand_ftp">

  <!-- Left 7-DoF arm -->
  <group name="left_arm">
    <chain base_link="torso_link" tip_link="left_wrist_yaw_link"/>
  </group>

  <!-- Right 7-DoF arm -->
  <group name="right_arm">
    <chain base_link="torso_link" tip_link="right_wrist_yaw_link"/>
  </group>

  <!-- Both arms together -->
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>


  <!-- Self-collision matrix generated by MoveIt Setup Assistant -->
    <disable_collisions link1="head_link" link2="left_hip_pitch_link" reason="Never"/>
