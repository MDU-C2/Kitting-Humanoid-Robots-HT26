<?xml version="1.0"?>
<robot name="g1_29dof_with_inspire_hand_ftp">

  <!-- Left 7-DoF arm -->
  <group name="left_arm">
    <chain base_link="torso_link" tip_link="left_wrist_yaw_link"/>
  </group>

  <!-- Right 7-DoF arm -->
  <group name="right_arm">
    <chain base_link="torso_link" tip_link="right_wrist_yaw_link"/>
  </group>

  <!-- Both arms together -->
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>


  <!-- G1_INSPIRE_FTP_MOVEIT_TRAJECTORY: independent joints only; mimic joints follow URDF. -->
  <group name="left_hand">
    <joint name="left_little_1_joint"/>
    <joint name="left_ring_1_joint"/>
    <joint name="left_middle_1_joint"/>
    <joint name="left_index_1_joint"/>
    <joint name="left_thumb_2_joint"/>
    <joint name="left_thumb_1_joint"/>
  </group>
  <group name="right_hand">
    <joint name="right_little_1_joint"/>
    <joint name="right_ring_1_joint"/>
    <joint name="right_middle_1_joint"/>
    <joint name="right_index_1_joint"/>
    <joint name="right_thumb_2_joint"/>
    <joint name="right_thumb_1_joint"/>
  </group>
  <group name="both_hands">
    <group name="left_hand"/>
    <group name="right_hand"/>
  </group>

  <!-- Self-collision matrix generated by MoveIt Setup Assistant -->
    <disable_collisions link1="head_link" link2="left_hip_pitch_link" reason="Never"/>
    <disable_collisions link1="head_link" link2="left_hip_roll_link" reason="Never"/>
    <disable_collisions link1="head_link" link2="left_hip_yaw_link" reason="Never"/>
    <disable_collisions link1="head_link" link2="left_shoulder_pitch_link" reason="Never"/>
