    <disable_collisions link1="head_link" link2="right_hip_roll_link" reason="Never"/>
    <disable_collisions link1="head_link" link2="right_shoulder_pitch_link" reason="Never"/>
    <disable_collisions link1="head_link" link2="torso_link" reason="Adjacent"/>
    <disable_collisions link1="left_ankle_pitch_link" link2="left_ankle_roll_link" reason="Adjacent"/>
    <disable_collisions link1="left_ankle_pitch_link" link2="left_hip_pitch_link" reason="Never"/>
